# Atlas → Database → Connect → Drivers. Use a database user limited to this database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=touch_grass
# Shared secret the app sends as x-api-key (pass to the app with --dart-define=SYNC_API_KEY=...).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
PORT=8080
# Web app origins allowed to call this API from a browser, comma-separated (no trailing slash), e.g.
#   ALLOWED_ORIGINS=https://touch-grass.example.com,http://localhost:5173
# Leave empty for no browser access. `*` allows any site; fine for testing, avoid it in production.
ALLOWED_ORIGINS=
# Serve the built web app (web/dist) from this same server: same origin, so no CORS and no mixed content.
#   STATIC_DIR=../web/dist
# Put the server behind HTTPS (the host usually does this): microphone, camera and the offline app need it.
STATIC_DIR=
